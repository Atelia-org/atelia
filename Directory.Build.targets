<Project>
  <Target Name="ValidateCompletionSourceConfiguration" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(UseCompletionSources)' != 'true' AND '$(UseCompletionSources)' != 'false'"
           Text="UseCompletionSources must be true or false." />
    <Error Condition="'$(UseCompletionSources)' == 'true' AND '$(CompletionSourceRoot)' == ''"
           Text="UseCompletionSources=true requires CompletionSourceRoot to be the absolute path of an atelia-completion checkout." />
    <Error Condition="'$(UseCompletionSources)' == 'true' AND '$(CompletionSourceRoot)' != '' AND !$([System.IO.Path]::IsPathFullyQualified('$(CompletionSourceRoot)'))"
           Text="CompletionSourceRoot must be an absolute path." />
    <Error Condition="'$(UseCompletionSources)' == 'true' AND (!Exists('$(CompletionSourceRoot)/src/Diagnostics/Diagnostics.csproj') OR !Exists('$(CompletionSourceRoot)/src/Completion.Abstractions/Completion.Abstractions.csproj') OR !Exists('$(CompletionSourceRoot)/src/Completion/Completion.csproj') OR !Exists('$(CompletionSourceRoot)/src/Completion.Tools/Completion.Tools.csproj'))"
           Text="CompletionSourceRoot must contain the four atelia-completion projects: $(CompletionSourceRoot)" />
  </Target>
  <Target Name="RejectCompletionSourcePack" BeforeTargets="Pack;GenerateNuspec;_IntermediatePack" Condition="'$(UseCompletionSources)' == 'true'">
    <Error Text="Packing a consumer with UseCompletionSources=true is unsupported. Pack atelia-completion with a unique version first, then pack this repository with UseCompletionSources=false and CompletionPackageVersion set to that version." />
  </Target>
  <Target Name="ValidateStorageSourceConfiguration" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(UseStorageSources)' != 'true' AND '$(UseStorageSources)' != 'false'"
           Text="UseStorageSources must be true or false." />
    <Error Condition="'$(UseStorageSources)' == 'true' AND '$(StorageSourceRoot)' == ''"
           Text="UseStorageSources=true requires StorageSourceRoot to be the absolute path of an atelia-storage checkout." />
    <Error Condition="'$(UseStorageSources)' == 'true' AND '$(StorageSourceRoot)' != '' AND !$([System.IO.Path]::IsPathFullyQualified('$(StorageSourceRoot)'))"
           Text="StorageSourceRoot must be an absolute path." />
    <Error Condition="'$(UseStorageSources)' == 'true' AND (!Exists('$(StorageSourceRoot)/src/Primitives/Primitives.csproj') OR !Exists('$(StorageSourceRoot)/src/Data/Data.csproj') OR !Exists('$(StorageSourceRoot)/src/Rbf/Rbf.csproj') OR !Exists('$(StorageSourceRoot)/src/RbfSegmentStore/RbfSegmentStore.csproj') OR !Exists('$(StorageSourceRoot)/src/EventJournal/EventJournal.csproj'))"
           Text="StorageSourceRoot must contain the five atelia-storage projects: $(StorageSourceRoot)" />
  </Target>
  <Target Name="RejectStorageSourcePack" BeforeTargets="Pack;GenerateNuspec;_IntermediatePack" Condition="'$(UseStorageSources)' == 'true'">
    <Error Text="Packing a consumer with UseStorageSources=true is unsupported. Pack atelia-storage with a unique version first, then pack this repository with UseStorageSources=false and StoragePackageVersion set to that version." />
  </Target>
  <!-- Optional self-analysis support. Invoke with: dotnet build <analyzer csproj> -p:UseSelfAnalyzers=true -->
  <PropertyGroup>
    <!-- Off by default to avoid accidental two-phase behavior in normal solution builds -->
    <UseSelfAnalyzers Condition="'$(UseSelfAnalyzers)'==''">false</UseSelfAnalyzers>
  </PropertyGroup>

  <!-- When explicitly requested, add the freshly built analyzer + codefix assemblies back so the analyzer project self-analyzes. -->
  <!-- <ItemGroup Condition="'$(UseSelfAnalyzers)'=='true' AND '$(MSBuildProjectName)'=='Atelia.Analyzers.Style'"> -->
  <ItemGroup Condition="'$(UseSelfAnalyzers)'=='true'">
    <!-- Use absolute (repo-root anchored) paths; assumes default Configuration & target framework -->
    <Analyzer Include="$(MSBuildThisFileDirectory)src/Analyzers.Style/bin/$(Configuration)/netstandard2.0/Atelia.Analyzers.Style.dll" Condition="Exists('$(MSBuildThisFileDirectory)src/Analyzers.Style/bin/$(Configuration)/netstandard2.0/Atelia.Analyzers.Style.dll')" />
    <Analyzer Include="$(MSBuildThisFileDirectory)src/Analyzers.Style.CodeFixes/bin/$(Configuration)/netstandard2.0/Atelia.Analyzers.Style.CodeFixes.dll" Condition="Exists('$(MSBuildThisFileDirectory)src/Analyzers.Style.CodeFixes/bin/$(Configuration)/netstandard2.0/Atelia.Analyzers.Style.CodeFixes.dll')" />
  </ItemGroup>

  <!-- Helpful message -->
  <Target Name="_ReportSelfAnalyzers" BeforeTargets="CoreCompile" Condition="'$(UseSelfAnalyzers)'=='true' AND '$(MSBuildProjectName)'=='Atelia.Analyzers.Style'">
    <Message Importance="High" Text="[MemoTree] Self-analysis enabled: using analyzer + codefix DLLs from previous build output." />
  </Target>
</Project>
