# Required. JSON array, not a comma-separated string.
CODEX_BRIDGE_ALLOWED_ROOTS=["/home/user/projects"]

# Optional. Defaults to the first allowed root.
CODEX_BRIDGE_DEFAULT_CWD=/home/user/projects

# Optional process configuration.
CODEX_BRIDGE_CODEX_COMMAND=codex
# The secure default also disables inherited Codex MCP servers and apps.
CODEX_BRIDGE_CODEX_ARGS=["app-server","--stdio","-c","mcp_servers={}","-c","features.apps=false"]

# stdio is recommended for Secure MCP Tunnel. Use http for Inspector/public fallback.
CODEX_BRIDGE_TRANSPORT=stdio
CODEX_BRIDGE_HTTP_HOST=127.0.0.1
CODEX_BRIDGE_HTTP_PORT=3000

CODEX_BRIDGE_DEFAULT_WAIT_MS=20000
CODEX_BRIDGE_MAX_WAIT_MS=60000
CODEX_BRIDGE_RPC_TIMEOUT_MS=30000
CODEX_BRIDGE_MAX_RESULT_CHARS=12000
CODEX_BRIDGE_MAX_PROGRESS_CHARS=2000
CODEX_BRIDGE_VERBOSE=false

