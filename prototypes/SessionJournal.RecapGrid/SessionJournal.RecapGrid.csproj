<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Atelia.EventJournal" Version="$(StoragePackageVersion)" Condition="'$(UseStorageSources)' != 'true'" />
    <ProjectReference Include="$(StorageSourceRoot)/src/EventJournal/EventJournal.csproj" Condition="'$(UseStorageSources)' == 'true'" />
    <PackageReference Include="Atelia.Completion.Abstractions" Version="$(CompletionPackageVersion)" Condition="'$(UseCompletionSources)' != 'true'" />
    <ProjectReference Include="$(CompletionSourceRoot)/src/Completion.Abstractions/Completion.Abstractions.csproj" Condition="'$(UseCompletionSources)' == 'true'" />
    <PackageReference Include="Atelia.Completion.Tools" Version="$(CompletionPackageVersion)" Condition="'$(UseCompletionSources)' != 'true'" />
    <ProjectReference Include="$(CompletionSourceRoot)/src/Completion.Tools/Completion.Tools.csproj" Condition="'$(UseCompletionSources)' == 'true'" />
    <ProjectReference Include="../SessionJournal/SessionJournal.csproj" />
    <ProjectReference Include="../SessionJournal.HistoryTimeline/SessionJournal.HistoryTimeline.csproj" />
    <ProjectReference Include="../SessionJournal.RecapGrid.Cadence/SessionJournal.RecapGrid.Cadence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Store/SchemaV4.sql" LogicalName="Atelia.SessionJournal.RecapGrid.Store.SchemaV4.sql" />
    <EmbeddedResource Include="Store/SchemaV5.sql" LogicalName="Atelia.SessionJournal.RecapGrid.Store.SchemaV5.sql" />
    <InternalsVisibleTo Include="Atelia.SessionJournal.RecapGrid.Control.Tests" />
    <InternalsVisibleTo Include="Atelia.SessionJournal.RecapGrid.Control.CrashHarness" />
    <InternalsVisibleTo Include="Atelia.SessionJournal.RecapGrid.Store.Tests" />
    <InternalsVisibleTo Include="Atelia.SessionJournal.RecapGrid.Store.CrashHarness" />
    <InternalsVisibleTo Include="Atelia.SessionJournal.RecapGrid.Manager.Tests" />
    <InternalsVisibleTo Include="Atelia.SessionJournal.RecapGrid.Runtime.Tests" />
    <InternalsVisibleTo Include="Atelia.SessionJournal.RecapGrid.Getter.Tests" />
    <InternalsVisibleTo Include="Atelia.SessionJournal.RecapGrid.Hosting.Tests" />
    <InternalsVisibleTo Include="Atelia.SessionJournal.RecapGrid.Online.Tests" />
    <InternalsVisibleTo Include="Atelia.SessionJournal.RecapGrid.AgentControl.Tests" />
  </ItemGroup>

</Project>
