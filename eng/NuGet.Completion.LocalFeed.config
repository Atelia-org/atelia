<?xml version="1.0" encoding="utf-8"?>
<!-- Standing local feed mode. Selected via RestoreConfigFile in CompletionDependency.Local.props (方式 A). -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="../gitignore/completion-local-cache" />
  </config>
  <packageSources>
    <clear />
    <add key="completion-local" value="../gitignore/completion-local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <fallbackPackageFolders><clear /></fallbackPackageFolders>
  <disabledPackageSources><clear /></disabledPackageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="completion-local">
      <package pattern="Atelia.Diagnostics" />
      <package pattern="Atelia.Completion.Abstractions" />
      <package pattern="Atelia.Completion" />
      <package pattern="Atelia.Completion.Tools" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Atelia.Diagnostics" />
      <package pattern="Atelia.Completion.Abstractions" />
      <package pattern="Atelia.Completion" />
      <package pattern="Atelia.Completion.Tools" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
