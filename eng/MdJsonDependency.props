<Project>
  <PropertyGroup>
    <MdJsonSourceRoot Condition="'$(MdJsonSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../md-json</MdJsonSourceRoot>
    <!-- Source identity exercised by Galatea's structured input integration. -->
    <MdJsonTestedSourceCommit>d9b60306f6c42cde9fce26e52fb329570ecf9a53</MdJsonTestedSourceCommit>
  </PropertyGroup>
  <Target Name="RequireMdJsonSources" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MdJsonSourceRoot)/src/MdJson/MdJson.csproj')"
           Text="MdJson sources are missing. Set MdJsonSourceRoot to the md-json repository root." />
  </Target>
</Project>
