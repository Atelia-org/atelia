<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>可复用的文本编辑脚本模型与严格 XML 解析器。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Atelia.Primitives" Version="$(StoragePackageVersion)" Condition="'$(UseStorageSources)' != 'true'" />
    <ProjectReference Include="$(StorageSourceRoot)/src/Primitives/Primitives.csproj" Condition="'$(UseStorageSources)' == 'true'" />
  </ItemGroup>
</Project>
